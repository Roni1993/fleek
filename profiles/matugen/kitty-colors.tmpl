# --- Matugen theme: full wallpaper-derived palette ---
# Base + ANSI all from matugen; saturate keeps them vivid (Material-You
# container colors are otherwise too muted).
background            {{ colors.background.default.hex | auto_lightness: 10 }}
foreground            {{ colors.on_background.default.hex }}
cursor                {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}
cursor_text_color     {{ colors.on_primary.default.hex }}
selection_background  {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}
selection_foreground  {{ colors.on_primary.default.hex }}
url_color             {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}

# --- ANSI (vivid via saturate) ---
color0  {{ colors.surface_variant.default.hex }}
color1  {{ colors.error.default.hex | to_color | saturate: 60.0, "hsl" }}
color2  {{ colors.tertiary.default.hex | to_color | saturate: 60.0, "hsl" }}
color3  {{ colors.secondary.default.hex | to_color | saturate: 60.0, "hsl" }}
color4  {{ colors.primary.default.hex | to_color | saturate: 60.0, "hsl" }}
color5  {{ colors.tertiary.default.hex | to_color | saturate: 60.0, "hsl" }}
color6  {{ colors.secondary.default.hex | to_color | saturate: 60.0, "hsl" }}
color7  {{ colors.on_surface.default.hex }}
color8  {{ colors.outline.default.hex }}
color9  {{ colors.error_container.default.hex | to_color | saturate: 60.0, "hsl" }}
color10 {{ colors.tertiary_container.default.hex | to_color | saturate: 60.0, "hsl" }}
color11 {{ colors.secondary_container.default.hex | to_color | saturate: 60.0, "hsl" }}
color12 {{ colors.primary_container.default.hex | to_color | saturate: 60.0, "hsl" }}
color13 {{ colors.on_secondary_container.default.hex | to_color | saturate: 60.0, "hsl" }}
color14 {{ colors.on_primary_container.default.hex | to_color | saturate: 60.0, "hsl" }}
color15 {{ colors.on_surface.default.hex }}
