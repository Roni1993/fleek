# --- Matugen (scheme-expressive): full palette with forced lightness ---
# set_lightness normalizes contrast so ANSI stays readable on light AND dark
# backgrounds, with distinct normal/bright pairs (L45 / L68).
background            {{ colors.background.default.hex | auto_lightness: 10 }}
foreground            {{ colors.on_background.default.hex }}
cursor                {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" }}
cursor_text_color     {{ colors.on_primary.default.hex }}
selection_background  {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" }}
selection_foreground  {{ colors.on_primary.default.hex }}
url_color             {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" }}
active_border_color   {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" }}
inactive_border_color {{ colors.outline.default.hex }}

# --- ANSI (custom scheme: wallpaper hues, contrast-solved per mode) ---
# lightness solved by palette.py: dark = normal darkest-readable/bright lighter,
# light = normal lightest-readable/bright darker; color0/7/8/15 stay Material
color0  {{ colors.surface_variant.default.hex | to_color | set_lightness: 20 }}
color1  {{ colors.red.default.hex }}
color2  {{ colors.green.default.hex }}
color3  {{ colors.yellow.default.hex }}
color4  {{ colors.blue.default.hex }}
color5  {{ colors.magenta.default.hex }}
color6  {{ colors.cyan.default.hex }}
color7  {{ colors.on_surface.default.hex }}
color8  {{ colors.outline.default.hex | to_color | set_lightness: 35 }}
color9  {{ colors.red_bright.default.hex }}
color10 {{ colors.green_bright.default.hex }}
color11 {{ colors.yellow_bright.default.hex }}
color12 {{ colors.blue_bright.default.hex }}
color13 {{ colors.magenta_bright.default.hex }}
color14 {{ colors.cyan_bright.default.hex }}
color15 {{ colors.on_surface.default.hex }}
