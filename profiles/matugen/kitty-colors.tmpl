# --- Matugen (scheme-expressive): full palette with forced lightness ---
# set_lightness normalizes contrast so ANSI stays readable on light AND dark
# backgrounds, with distinct normal/bright pairs (L45 / L68).
background            {{ colors.background.default.hex | auto_lightness: 10 }}
foreground            {{ colors.on_background.default.hex }}
cursor                {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" }}
cursor_text_color     {{ colors.on_primary.default.hex }}
selection_background  {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" }}
selection_foreground  {{ colors.on_primary.default.hex }}
url_color             {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" }}
active_border_color   {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" }}
inactive_border_color {{ colors.outline.default.hex }}

# --- ANSI (forced lightness: normal 45, bright 68) ---
# hue map: 1 red(error) 2 teal-green(tertiary) 3 blue(sec+230) 4 orange(primary)
#          5 magenta(tertiary+300) 6 cyan(sec+195)
color0  {{ colors.surface_variant.default.hex | to_color | set_lightness: 20 }}
color1  {{ colors.error.default.hex | to_color | saturate: 65.0, "hsl" | set_lightness: 45 }}
color2  {{ colors.tertiary.default.hex | to_color | saturate: 65.0, "hsl" | set_lightness: 45 }}
color3  {{ colors.secondary.default.hex | to_color | saturate: 65.0, "hsl" | set_hue: 230 | set_lightness: 45 }}
color4  {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" | set_lightness: 45 }}
color5  {{ colors.tertiary.default.hex | to_color | saturate: 65.0, "hsl" | set_hue: 300 | set_lightness: 45 }}
color6  {{ colors.secondary.default.hex | to_color | saturate: 65.0, "hsl" | set_hue: 195 | set_lightness: 45 }}
color7  {{ colors.on_surface.default.hex }}
color8  {{ colors.outline.default.hex | to_color | set_lightness: 35 }}
color9  {{ colors.error.default.hex | to_color | saturate: 65.0, "hsl" | set_lightness: 68 }}
color10 {{ colors.tertiary.default.hex | to_color | saturate: 65.0, "hsl" | set_lightness: 68 }}
color11 {{ colors.secondary.default.hex | to_color | saturate: 65.0, "hsl" | set_hue: 230 | set_lightness: 68 }}
color12 {{ colors.primary.default.hex | to_color | saturate: 65.0, "hsl" | set_lightness: 68 }}
color13 {{ colors.tertiary.default.hex | to_color | saturate: 65.0, "hsl" | set_hue: 300 | set_lightness: 68 }}
color14 {{ colors.secondary.default.hex | to_color | saturate: 65.0, "hsl" | set_hue: 195 | set_lightness: 68 }}
color15 {{ colors.on_surface.default.hex }}
