# --- Matugen theme (scheme-expressive), based on matugen-themes kitty template ---
# Distinct ANSI hues (orange/teal/blue/red) from the wallpaper; saturate
# keeps them vivid; auto_lightness lifts the background.

# --- Main Colors ---
background            {{ colors.background.default.hex | auto_lightness: 10 }}
foreground            {{ colors.on_background.default.hex }}
cursor                {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}
cursor_text_color     {{ colors.on_primary.default.hex }}
selection_background  {{ colors.secondary_container.default.hex | to_color | saturate: 40.0, "hsl" }}
selection_foreground  {{ colors.on_secondary_container.default.hex }}
url_color             {{ colors.tertiary.default.hex | to_color | saturate: 40.0, "hsl" }}

# --- ANSI Colors ---
color0  {{ colors.surface.default.hex }}
color1  {{ colors.error.default.hex | to_color | saturate: 40.0, "hsl" }}
color2  {{ colors.tertiary.default.hex | to_color | saturate: 40.0, "hsl" }}
color3  {{ colors.secondary.default.hex | to_color | saturate: 40.0, "hsl" }}
color4  {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}
color5  {{ colors.tertiary_fixed_dim.default.hex | to_color | saturate: 40.0, "hsl" }}
color6  {{ colors.secondary_fixed_dim.default.hex | to_color | saturate: 40.0, "hsl" }}
color7  {{ colors.on_surface.default.hex }}
color8  {{ colors.surface_variant.default.hex }}
color9  {{ colors.error_container.default.hex | to_color | saturate: 40.0, "hsl" }}
color10 {{ colors.tertiary_container.default.hex | to_color | saturate: 40.0, "hsl" }}
color11 {{ colors.secondary_container.default.hex | to_color | saturate: 40.0, "hsl" }}
color12 {{ colors.primary_container.default.hex | to_color | saturate: 40.0, "hsl" }}
color13 {{ colors.on_secondary_fixed_variant.default.hex }}
color14 {{ colors.on_tertiary_fixed_variant.default.hex }}
color15 {{ colors.on_surface_variant.default.hex }}

# --- UI Elements ---
active_tab_foreground   {{ colors.on_primary.default.hex }}
active_tab_background   {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}
inactive_tab_foreground {{ colors.on_primary_container.default.hex }}
inactive_tab_background {{ colors.primary_container.default.hex }}
active_border_color     {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}
inactive_border_color   {{ colors.outline.default.hex }}
