# --- Matugen theme: wallpaper-derived chrome ---
# bg/fg/accent from matugen. ANSI is a FIXED natural palette (Tango) —
# matugen's Material/base16 colors are wallpaper-dominated (green here)
# and indistinguishable in the terminal.
background            {{ colors.background.default.hex | auto_lightness: 10 }}
foreground            {{ colors.on_background.default.hex }}
cursor                {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}
cursor_text_color     {{ colors.on_primary.default.hex }}
selection_background  {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}
selection_foreground  {{ colors.on_primary.default.hex }}
url_color             {{ colors.primary.default.hex | to_color | saturate: 40.0, "hsl" }}

# --- ANSI: Tango (natural, distinguishable) ---
color0  #2e3436
color1  #cc0000
color2  #4e9a06
color3  #c4a000
color4  #3465a4
color5  #75507b
color6  #06989a
color7  #d3d7cf
color8  #555753
color9  #ef2929
color10 #8ae234
color11 #fce94f
color12 #729fcf
color13 #ad7fa8
color14 #34e2e2
color15 #eeeeec
